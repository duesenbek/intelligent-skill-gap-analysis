# CareerLens — Configuration Example
# Copy this file to .env and fill in real values.
# Never commit the actual .env file.

# Application
APP_NAME=CareerLens
APP_ENV=development
DEBUG=true
SECRET_KEY=replace-with-a-long-random-string

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/careerlens_db

# Authentication
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# External APIs (optional)
# OPENAI_API_KEY=
# COURSERA_API_KEY=
